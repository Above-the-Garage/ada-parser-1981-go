(DEFPROP COMPILATION (/{ COMPILATION-UNIT }) GRAMMAR)

(DEFPROP COMPILATION-UNIT (CONTEXT-CLAUSE LIBRARY-UNIT) GRAMMAR)

(DEFPROP CONTEXT-CLAUSE (/{ CONTEXT-ITEM }) GRAMMAR)

(DEFPROP CONTEXT-ITEM (WITH-CLAUSE ! USE-CLAUSE ! PRAGMA) GRAMMAR)

(DEFPROP WITH-CLAUSE ((^ WITH) NAME (/{ /, NAME }) ;) GRAMMAR)

(DEFPROP USE-CLAUSE ((^ USE) NAME (/{ /, NAME }) ;) GRAMMAR)

(DEFPROP LIBRARY-UNIT
 (SUBPROGRAM-DECLARATION ! GENERIC-DECLARATION ! GENERIC-INSTANTIATION !
  RENAMING-DECLARATION ! SUBPROGRAM-BODY ! PACKAGE-DECLARATION !
  PACKAGE-BODY ! SUBUNIT)
 GRAMMAR)

(DEFPROP SUBUNIT ((^ SEPARATE) /( NAME /) PROPER-BODY) GRAMMAR)

(DEFPROP PRAGMA
 ((^ PRAGMA) IDENTIFIER (/[ /( ARGUMENT (/{ /, ARGUMENT }) /) /]) ;)
 GRAMMAR)

(DEFPROP ARGUMENT ((/[ IDENTIFIER => /]) EXPRESSION) GRAMMAR)

(DEFPROP DECLARATIVE-PART (/{ DECLARATIVE-ITEM }) GRAMMAR)

(DEFPROP DECLARATIVE-ITEM
 (BASIC-DECLARATION ! BODY-STUB ! PROPER-BODY ! USE-CLAUSE !
  REPRESENTATION-CLAUSE ! PRAGMA)
 GRAMMAR)

(DEFPROP BASIC-DECLARATION
 (OBJECT-DECLARATION ! NUMBER-DECLARATION ! EXCEPTION-DECLARATION !
  RENAMING-DECLARATION ! TYPE-DECLARATION ! SUBTYPE-DECLARATION !
  SUBPROGRAM-DECLARATION ! PACKAGE-DECLARATION ! TASK-DECLARATION !
  GENERIC-DECLARATION ! GENERIC-INSTANTIATION)
 GRAMMAR)

(DEFPROP PROPER-BODY (SUBPROGRAM-BODY ! PACKAGE-BODY ! TASK-BODY) GRAMMAR)

(DEFPROP OBJECT-DECLARATION
 (IDENTIFIER-LIST : (/[ (^ CONSTANT) /]) OBJECT-TYPE (/[ := EXPRESSION /]) ;)
 GRAMMAR)

(DEFPROP OBJECT-TYPE (ARRAY-TYPE-DEFINITION ! SUBTYPE-INDICATION) GRAMMAR)

(DEFPROP NUMBER-DECLARATION
 (IDENTIFIER-LIST : (^ CONSTANT) := EXPRESSION ;)
 GRAMMAR)

(DEFPROP EXCEPTION-DECLARATION (IDENTIFIER-LIST : (^ EXCEPTION) ;) GRAMMAR)

(DEFPROP IDENTIFIER-LIST (IDENTIFIER (/{ /, IDENTIFIER })) GRAMMAR)

(DEFPROP RENAMING-DECLARATION
 ((IDENTIFIER : (^ EXCEPTION) (^ RENAMES) NAME ;) !
  (IDENTIFIER : NAME (^ RENAMES) NAME ;) !
  ((^ PACKAGE) IDENTIFIER (^ RENAMES) NAME ;) !
  ((^ TASK) IDENTIFIER (^ RENAMES) NAME ;) !
  (SUBPROGRAM-SPECIFICATION (^ RENAMES) NAME ;))
 GRAMMAR)

(DEFPROP TYPE-DECLARATION
 ((^ TYPE) IDENTIFIER (/[ DISCRIMINANT-PART /])
  (/[ (^ IS) TYPE-DEFINITION /]) ;)
 GRAMMAR)

(DEFPROP TYPE-DEFINITION
 (ENUMERATION-TYPE-DEFINITION ! INTEGER-TYPE-DEFINITION !
  REAL-TYPE-DEFINITION ! ARRAY-TYPE-DEFINITION ! RECORD-TYPE-DEFINITION !
  ACCESS-TYPE-DEFINITION ! DERIVED-TYPE-DEFINITION !
  PRIVATE-TYPE-DEFINITION)
 GRAMMAR)

(DEFPROP SUBTYPE-DECLARATION
 ((^ SUBTYPE) IDENTIFIER (^ IS) SUBTYPE-INDICATION ;)
 GRAMMAR)

(DEFPROP SUBTYPE-INDICATION (NAME (/[ CONSTRAINT /])) GRAMMAR)

(DEFPROP CONSTRAINT
 (RANGE-CONSTRAINT ! FLOATING-POINT-CONSTRAINT ! FIXED-POINT-CONSTRAINT)
 GRAMMAR)

(DEFPROP RANGE-CONSTRAINT ((^ RANGE) RANGE) GRAMMAR)

(DEFPROP RANGE ((SIMPLE-EXPRESSION /./. SIMPLE-EXPRESSION) ! NAME) GRAMMAR)

(DEFPROP DISCRETE-RANGE ((NAME RANGE-CONSTRAINT) ! RANGE) GRAMMAR)

(DEFPROP ENUMERATION-TYPE-DEFINITION
 (/( ENUMERATION-LITERAL (/{ /, ENUMERATION-LITERAL }) /))
 GRAMMAR)

(DEFPROP ENUMERATION-LITERAL (IDENTIFIER ! CHARACTER-LITERAL) GRAMMAR)

(DEFPROP INTEGER-TYPE-DEFINITION (RANGE-CONSTRAINT) GRAMMAR)

(DEFPROP REAL-TYPE-DEFINITION
 (FLOATING-POINT-CONSTRAINT ! FIXED-POINT-CONSTRAINT)
 GRAMMAR)

(DEFPROP FLOATING-POINT-CONSTRAINT
 ((^ DIGITS) SIMPLE-EXPRESSION (/[ RANGE-CONSTRAINT /]))
 GRAMMAR)

(DEFPROP FIXED-POINT-CONSTRAINT
 ((^ DELTA) SIMPLE-EXPRESSION (/[ RANGE-CONSTRAINT /]))
 GRAMMAR)

(DEFPROP ARRAY-TYPE-DEFINITION
 (UNCONSTRAINED-ARRAY-DEFINITION ! CONSTRAINED-ARRAY-DEFINITION)
 GRAMMAR)

(DEFPROP UNCONSTRAINED-ARRAY-DEFINITION
 ((^ ARRAY) /( INDEX-SUBTYPE-DEFINITION (/{ /, INDEX-SUBTYPE-DEFINITION }) /)
  (^ OF) SUBTYPE-INDICATION)
 GRAMMAR)

(DEFPROP INDEX-SUBTYPE-DEFINITION (NAME (^ RANGE) <>) GRAMMAR)

(DEFPROP CONSTRAINED-ARRAY-DEFINITION
 ((^ ARRAY) /( DISCRETE-RANGE (/{ /, DISCRETE-RANGE }) /)
  (^ OF) SUBTYPE-INDICATION)
 GRAMMAR)

(DEFPROP RECORD-TYPE-DEFINITION
 ((^ RECORD) COMPONENT-LIST (^ END) (^ RECORD))
 GRAMMAR)

(DEFPROP COMPONENT-LIST
 (((^ NULL) ;) ! ((/{ COMPONENT-DECLARATION }) (/[ VARIANT-PART /])))
 GRAMMAR)

(DEFPROP COMPONENT-DECLARATION
 (IDENTIFIER-LIST : OBJECT-TYPE (/[ := EXPRESSION /]) ;)
 GRAMMAR)

(DEFPROP DISCRIMINANT-PART
 (/( DISCRIMINANT-SPECIFICATION (/{ ; DISCRIMINANT-SPECIFICATION }) /))
 GRAMMAR)

(DEFPROP DISCRIMINANT-SPECIFICATION
 (IDENTIFIER-LIST : NAME (/[ := EXPRESSION /]))
 GRAMMAR)

(DEFPROP VARIANT-PART
 ((^ CASE) NAME (^ IS) (/{ VARIANT }) (^ END) (^ CASE) ;)
 GRAMMAR)

(DEFPROP VARIANT ((^ WHEN) CHOICE-LIST => COMPONENT-LIST) GRAMMAR)

(DEFPROP CHOICE-LIST (CHOICE (/{ | CHOICE })) GRAMMAR)

(DEFPROP CHOICE
 ((^ OTHERS) ! (NAME RANGE-CONSTRAINT) !
  (SIMPLE-EXPRESSION /./. SIMPLE-EXPRESSION) ! EXPRESSION)
 GRAMMAR)

(DEFPROP ACCESS-TYPE-DEFINITION ((^ ACCESS) SUBTYPE-INDICATION) GRAMMAR)

(DEFPROP DERIVED-TYPE-DEFINITION ((^ NEW) SUBTYPE-INDICATION) GRAMMAR)

(DEFPROP PRIVATE-TYPE-DEFINITION ((/[ (^ LIMITED) /]) (^ PRIVATE)) GRAMMAR)

(DEFPROP NAME (NAME-HEAD (/{ NAME-TAIL })) GRAMMAR)

(DEFPROP NAME-HEAD (IDENTIFIER ! CHARACTER-STRING) GRAMMAR)

(DEFPROP NAME-TAIL
 ((/. SELECTOR) ! (/' AGGREGATE) ! (/' ATTRIBUTE-DESIGNATOR) !
  (/( ACTUAL-PARAMETER (/{ /, ACTUAL-PARAMETER }) /)))
 GRAMMAR)

(DEFPROP SELECTOR
 (IDENTIFIER ! (^ ALL) ! CHARACTER-STRING ! CHARACTER-LITERAL)
 GRAMMAR)

(DEFPROP ATTRIBUTE-DESIGNATOR
 (IDENTIFIER ! (^ RANGE) ! (^ DIGITS) ! (^ DELTA))
 GRAMMAR)

(DEFPROP ACTUAL-PARAMETER
 ((NAME RANGE-CONSTRAINT) ! (SIMPLE-EXPRESSION /./. SIMPLE-EXPRESSION) !
  ((/[ IDENTIFIER => /]) EXPRESSION))
 GRAMMAR)

(DEFPROP AGGREGATE
 (/( COMPONENT-ASSOCIATION (/{ /, COMPONENT-ASSOCIATION }) /))
 GRAMMAR)

(DEFPROP COMPONENT-ASSOCIATION ((/[ CHOICE-LIST => /]) EXPRESSION) GRAMMAR)

(DEFPROP EXPRESSION (RELATION (/{ EXPRESSION-TAIL })) GRAMMAR)

(DEFPROP EXPRESSION-TAIL
 (((^ AND) (^ THEN) RELATION) ! ((^ OR) (^ ELSE) RELATION) !
  ((^ AND) RELATION) ! ((^ OR) RELATION) ! ((^ XOR) RELATION))
 GRAMMAR)

(DEFPROP RELATION (SIMPLE-EXPRESSION (/[ RELATION-TAIL /])) GRAMMAR)

(DEFPROP RELATION-TAIL
 ((RELATIONAL-OPERATOR SIMPLE-EXPRESSION) !
  ((/[ (^ NOT) /]) (^ IN) DISCRETE-RANGE))
 GRAMMAR)

(DEFPROP SIMPLE-EXPRESSION
 ((/[ UNARY-OPERATOR /]) TERM (/{ ADDING-OPERATOR TERM }))
 GRAMMAR)

(DEFPROP TERM (FACTOR (/{ MULTIPLYING-OPERATOR FACTOR })) GRAMMAR)

(DEFPROP FACTOR
 (((^ ABS) PRIMARY) ! ((^ NOT) PRIMARY) ! (PRIMARY (/[ ** PRIMARY /])))
 GRAMMAR)

(DEFPROP PRIMARY
 (LITERAL ! ALLOCATOR ! NAME ! (/( EXPRESSION /)) ! AGGREGATE)
 GRAMMAR)

(DEFPROP LITERAL
 (NUMERIC-LITERAL ! CHARACTER-LITERAL ! CHARACTER-STRING ! (^ NULL))
 GRAMMAR)

(DEFPROP ALLOCATOR ((^ NEW) NAME) GRAMMAR)

(DEFPROP RELATIONAL-OPERATOR (= ! //= ! < ! <= ! > ! >=) GRAMMAR)

(DEFPROP ADDING-OPERATOR (+ ! /- ! &) GRAMMAR)

(DEFPROP UNARY-OPERATOR (+ ! /-) GRAMMAR)

(DEFPROP MULTIPLYING-OPERATOR (* ! // ! (^ MOD) ! (^ REM)) GRAMMAR)

(DEFPROP SEQUENCE-OF-STATEMENTS (STATEMENT (/{ STATEMENT })) GRAMMAR)

(DEFPROP STATEMENT
 (((/{ LABEL }) COMPOUND-STATEMENT) ! ((/{ LABEL }) SIMPLE-STATEMENT))
 GRAMMAR)

(DEFPROP LABEL (<< IDENTIFIER >>) GRAMMAR)

(DEFPROP SIMPLE-STATEMENT
 (NULL-STATEMENT ! ASSIGNMENT-STATEMENT ! EXIT-STATEMENT !
  RETURN-STATEMENT ! GOTO-STATEMENT ! DELAY-STATEMENT ! ABORT-STATEMENT !
  RAISE-STATEMENT ! PRAGMA ! PROCEDURE-CALL)
 GRAMMAR)

(DEFPROP COMPOUND-STATEMENT
 (IF-STATEMENT ! CASE-STATEMENT ! LOOP-STATEMENT ! BLOCK !
  ACCEPT-STATEMENT ! SELECT-STATEMENT)
 GRAMMAR)

(DEFPROP NULL-STATEMENT ((^ NULL) ;) GRAMMAR)

(DEFPROP ASSIGNMENT-STATEMENT (NAME := EXPRESSION ;) GRAMMAR)

(DEFPROP PROCEDURE-CALL (NAME ;) GRAMMAR)

(DEFPROP EXIT-STATEMENT
 ((^ EXIT) (/[ NAME /]) (/[ (^ WHEN) CONDITION /]) ;)
 GRAMMAR)

(DEFPROP RETURN-STATEMENT ((^ RETURN) (/[ EXPRESSION /]) ;) GRAMMAR)

(DEFPROP GOTO-STATEMENT ((^ GOTO) NAME ;) GRAMMAR)

(DEFPROP DELAY-STATEMENT ((^ DELAY) SIMPLE-EXPRESSION ;) GRAMMAR)

(DEFPROP ABORT-STATEMENT ((^ ABORT) NAME (/{ /, NAME }) ;) GRAMMAR)

(DEFPROP RAISE-STATEMENT ((^ RAISE) (/[ NAME /]) ;) GRAMMAR)

(DEFPROP CONDITION (EXPRESSION) GRAMMAR)

(DEFPROP IF-STATEMENT
 ((^ IF) CONDITION (^ THEN) SEQUENCE-OF-STATEMENTS
  (/{ (^ ELSIF) CONDITION (^ THEN) SEQUENCE-OF-STATEMENTS })
  (/[ (^ ELSE) SEQUENCE-OF-STATEMENTS /])
  (^ END) (^ IF) ;)
 GRAMMAR)

(DEFPROP CASE-STATEMENT
 ((^ CASE) EXPRESSION (^ IS) (/{ CASE-ALTERNATIVE }) (^ END) (^ CASE) ;)
 GRAMMAR)

(DEFPROP CASE-ALTERNATIVE
 ((^ WHEN) CHOICE-LIST => SEQUENCE-OF-STATEMENTS)
 GRAMMAR)

(DEFPROP LOOP-STATEMENT
 ((/[ IDENTIFIER /: /]) (/[ ITERATION-SCHEME /])
  (^ LOOP) SEQUENCE-OF-STATEMENTS (^ END) (^ LOOP) (/[ IDENTIFIER /]) ;)
 GRAMMAR)

(DEFPROP ITERATION-SCHEME
 (((^ WHILE) CONDITION) !
  ((^ FOR) IDENTIFIER (^ IN) (/[ (^ REVERSE) /]) DISCRETE-RANGE))
 GRAMMAR)

(DEFPROP BLOCK
 ((/[ IDENTIFIER /: /]) (/[ (^ DECLARE) DECLARATIVE-PART /])
  (^ BEGIN) SEQUENCE-OF-STATEMENTS (/[ EXCEPTION-PART /])
  (^ END) (/[ IDENTIFIER /]) ;)
 GRAMMAR)

(DEFPROP EXCEPTION-PART
 ((^ EXCEPTION) EXCEPTION-HANDLER (/{ EXCEPTION-HANDLER }))
 GRAMMAR)

(DEFPROP EXCEPTION-HANDLER
 ((^ WHEN) EXCEPTION-CHOICE (/{ | EXCEPTION-CHOICE }) =>
  SEQUENCE-OF-STATEMENTS)
 GRAMMAR)

(DEFPROP EXCEPTION-CHOICE ((^ OTHERS) ! NAME) GRAMMAR)

(DEFPROP SUBPROGRAM-DECLARATION (SUBPROGRAM-SPECIFICATION ;) GRAMMAR)

(DEFPROP SUBPROGRAM-SPECIFICATION
 (((^ PROCEDURE) IDENTIFIER (/[ FORMAL-PART /])) !
  ((^ FUNCTION) DESIGNATOR (/[ FORMAL-PART /]) (^ RETURN) NAME))
 GRAMMAR)

(DEFPROP DESIGNATOR (IDENTIFIER ! CHARACTER-STRING) GRAMMAR)

(DEFPROP FORMAL-PART
 (/( PARAMETER-SPECIFICATION (/{ ; PARAMETER-SPECIFICATION }) /))
 GRAMMAR)

(DEFPROP PARAMETER-SPECIFICATION
 (IDENTIFIER-LIST : (/[ MODE /]) NAME (/[ := EXPRESSION /]))
 GRAMMAR)

(DEFPROP MODE (((^ IN) (^ OUT)) ! (^ IN) ! (^ OUT)) GRAMMAR)

(DEFPROP SUBPROGRAM-BODY
 (SUBPROGRAM-SPECIFICATION (^ IS) DECLARATIVE-PART
  (^ BEGIN) SEQUENCE-OF-STATEMENTS (/[ EXCEPTION-PART /])
  (^ END) (/[ DESIGNATOR /]) ;)
 GRAMMAR)

(DEFPROP PACKAGE-DECLARATION (PACKAGE-SPECIFICATION ;) GRAMMAR)

(DEFPROP PACKAGE-SPECIFICATION
 ((^ PACKAGE) IDENTIFIER (^ IS) (/{ BASIC-DECLARATIVE-ITEM })
  (/[ (^ PRIVATE) (/{ BASIC-DECLARATIVE-ITEM }) /])
  (^ END) (/[ IDENTIFIER /]))
 GRAMMAR)

(DEFPROP BASIC-DECLARATIVE-ITEM
 (BASIC-DECLARATION ! USE-CLAUSE ! REPRESENTATION-CLAUSE ! PRAGMA)
 GRAMMAR)

(DEFPROP PACKAGE-BODY
 ((^ PACKAGE) (^ BODY) IDENTIFIER (^ IS) DECLARATIVE-PART
  (/[ (^ BEGIN) SEQUENCE-OF-STATEMENTS (/[ EXCEPTION-PART /]) /])
  (^ END) (/[ IDENTIFIER /]) ;)
 GRAMMAR)

(DEFPROP TASK-DECLARATION
 ((^ TASK) (/[ (^ TYPE) /]) IDENTIFIER
  (/[ (^ IS) (/{ TASK-ITEM }) (^ END) (/[ IDENTIFIER /]) /]) ;)
 GRAMMAR)

(DEFPROP TASK-ITEM (ENTRY-DECLARATION ! REPRESENTATION-CLAUSE ! PRAGMA) GRAMMAR)

(DEFPROP ENTRY-DECLARATION
 ((^ ENTRY) IDENTIFIER (/[ /( DISCRETE-RANGE /) /]) (/[ FORMAL-PART /]) ;)
 GRAMMAR)

(DEFPROP TASK-BODY
 ((^ TASK) (^ BODY) IDENTIFIER (^ IS) DECLARATIVE-PART
  (^ BEGIN) SEQUENCE-OF-STATEMENTS (/[ EXCEPTION-PART /])
  (^ END) (/[ IDENTIFIER /]) ;)
 GRAMMAR)

(DEFPROP ACCEPT-STATEMENT
 ((^ ACCEPT) IDENTIFIER (/[ /( EXPRESSION /) /]) (/[ FORMAL-PART /])
  (/[ (^ DO) SEQUENCE-OF-STATEMENTS (^ END) (/[ IDENTIFIER /]) /]) ;)
 GRAMMAR)

(DEFPROP SELECT-STATEMENT
 (SELECTIVE-WAIT ! CONDITIONAL-ENTRY-CALL ! TIMED-ENTRY-CALL)
 GRAMMAR)

(DEFPROP SELECTIVE-WAIT
 ((^ SELECT) GUARDED-ALTERNATIVE (/{ (^ OR) GUARDED-ALTERNATIVE })
  (/[ (^ ELSE) SEQUENCE-OF-STATEMENTS /]) (^ END) (^ SELECT) ;)
 GRAMMAR)

(DEFPROP GUARDED-ALTERNATIVE
 ((/[ (^ WHEN) CONDITION => /]) SELECT-ALTERNATIVE)
 GRAMMAR)

(DEFPROP SELECT-ALTERNATIVE
 ((ACCEPT-STATEMENT (/[ SEQUENCE-OF-STATEMENTS /])) !
  (DELAY-STATEMENT (/[ SEQUENCE-OF-STATEMENTS /])) !
  ((^ TERMINATE) ;))
 GRAMMAR)

(DEFPROP CONDITIONAL-ENTRY-CALL
 ((^ SELECT) PROCEDURE-CALL (/[ SEQUENCE-OF-STATEMENTS /])
  (^ ELSE) SEQUENCE-OF-STATEMENTS (^ END) (^ SELECT) ;)
 GRAMMAR)

(DEFPROP TIMED-ENTRY-CALL
 ((^ SELECT) PROCEDURE-CALL (/[ SEQUENCE-OF-STATEMENTS /])
  (^ OR) DELAY-STATEMENT (/[ SEQUENCE-OF-STATEMENTS /])
  (^ END) (^ SELECT) ;)
 GRAMMAR)

(DEFPROP BODY-STUB
 ((SUBPROGRAM-SPECIFICATION (^ IS) (^ SEPARATE) ;) !
  ((^ PACKAGE) (^ BODY) IDENTIFIER (^ IS) (^ SEPARATE) ;) !
  ((^ TASK) (^ BODY) IDENTIFIER (^ IS) (^ SEPARATE) ;))
 GRAMMAR)

(DEFPROP GENERIC-DECLARATION
 (GENERIC-PART GENERIC-UNIT-SPECIFICATION ;)
 GRAMMAR)

(DEFPROP GENERIC-UNIT-SPECIFICATION
 (SUBPROGRAM-SPECIFICATION ! PACKAGE-SPECIFICATION)
 GRAMMAR)

(DEFPROP GENERIC-PART ((^ GENERIC) (/{ GENERIC-FORMAL-PARAMETER })) GRAMMAR)

(DEFPROP GENERIC-FORMAL-PARAMETER
 ((PARAMETER-SPECIFICATION ;) !
  ((^ TYPE) IDENTIFIER (/[ DISCRIMINANT-PART /]) (^ IS)
   GENERIC-TYPE-DEFINITION ;) !
  ((^ WITH) SUBPROGRAM-SPECIFICATION (/[ (^ IS) GENERIC-DEFAULT /]) ;))
 GRAMMAR)

(DEFPROP GENERIC-DEFAULT (<> ! NAME) GRAMMAR)

(DEFPROP GENERIC-TYPE-DEFINITION
 ((/( <> /)) ! ((^ RANGE) <>) ! ((^ DIGITS) <>) ! ((^ DELTA) <>) !
  ARRAY-TYPE-DEFINITION ! ACCESS-TYPE-DEFINITION ! PRIVATE-TYPE-DEFINITION)
 GRAMMAR)

(DEFPROP GENERIC-INSTANTIATION
 (((^ PACKAGE) IDENTIFIER (^ IS) (^ NEW) NAME ;) !
  ((^ PROCEDURE) IDENTIFIER (^ IS) (^ NEW) NAME ;) !
  ((^ FUNCTION) DESIGNATOR (^ IS) (^ NEW) NAME ;))
 GRAMMAR)

(DEFPROP REPRESENTATION-CLAUSE
 (RECORD-REPRESENTATION-CLAUSE ! ADDRESS-CLAUSE !
  LENGTH-OR-ENUMERATION-CLAUSE)
 GRAMMAR)

(DEFPROP LENGTH-OR-ENUMERATION-CLAUSE
 ((^ FOR) NAME (^ USE) EXPRESSION ;)
 GRAMMAR)

(DEFPROP RECORD-REPRESENTATION-CLAUSE
 ((^ FOR) NAME (^ USE) (^ RECORD) (/[ ALIGNMENT-CLAUSE /])
  (/{ COMPONENT-CLAUSE }) (^ END) (^ RECORD) ;)
 GRAMMAR)

(DEFPROP ALIGNMENT-CLAUSE ((^ AT) (^ MOD) SIMPLE-EXPRESSION ;) GRAMMAR)

(DEFPROP COMPONENT-CLAUSE
 (NAME (^ AT) SIMPLE-EXPRESSION (^ RANGE) RANGE ;)
 GRAMMAR)

(DEFPROP ADDRESS-CLAUSE
 ((^ FOR) NAME (^ USE) (^ AT) SIMPLE-EXPRESSION ;)
 GRAMMAR)
